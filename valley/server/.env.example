# 纪念碑谷后端环境变量
# 复制为 .env 后填写：copy .env.example .env

# 服务端口
PORT=3001

# JWT 签名密钥（必填）
# 生成一个：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# 数据库文件位置（可选，默认 ./db/valley.db）
# DB_PATH=./db/valley.db

# 允许跨域的前端地址（可选，默认 http://localhost:5173）
# CORS_ORIGIN=http://localhost:5173
